[Plymouth Theme]
Name=Violet-Plymouth
Description=Plymouth Theme Generated by pyppy
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/Violet-Plymouth
HorizontalAlignment=.5
VerticalAlignment=.5
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
